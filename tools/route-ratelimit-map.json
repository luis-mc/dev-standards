{
  "_comment": [
    "Route -> §17.3 rate-limit bucket, required by R17.7g. This mapping cannot",
    "be derived from the specification's prose: §19.4 lists paths and §17.3",
    "lists named actions, and nothing joins them mechanically. Declaring it here",
    "is what makes R17.7g's CI assertion possible.",
    "",
    "Bucket names correspond to rows in §17.3. 'default' means the endpoint",
    "inherits the registration bucket (5/hour/source) per R17.7g. A list means",
    "the endpoint dispatches to a per-factor counter and every listed bucket",
    "applies to its own branch."
  ],
  "/.well-known/openid-configuration": "default",
  "/.well-known/jwks.json": "default",
  "/v1/auth/register": "registration",
  "/v1/auth/email/verify": "otp_verify",
  "/v1/auth/email/verify/resend": "email_verification_resend",
  "/v1/auth/login/password": "password_login",
  "/v1/auth/login/otp/request": "otp_request",
  "/v1/auth/login/otp/verify": "otp_verify",
  "/v1/auth/login/passkey/options": "passkey_options_user",
  "/v1/auth/login/passkey/verify": "passkey_assertion",
  "/v1/auth/federated/{connection}/start": "federated_start",
  "/v1/auth/federated/{connection}/callback": "federated_callback",
  "/v1/auth/mfa/challenge": "mfa_challenge",
  "/v1/auth/mfa/verify": [
    "totp_verification",
    "passkey_assertion",
    "recovery_code"
  ],
  "/v1/auth/password/reset/request": "password_reset_request",
  "/v1/auth/password/reset/confirm": "otp_verify",
  "/v1/auth/session": "session_validation",
  "/v1/auth/logout": "session_validation",
  "/v1/auth/logout/all": "session_validation",
  "/v1/me": "session_validation",
  "/v1/me/email/change/request": "default",
  "/v1/me/email/change/confirm": "otp_verify",
  "/v1/me/email/change/cancel": "otp_verify",
  "/v1/me/password": "default",
  "/v1/me/credentials": "session_validation",
  "/v1/me/credentials/passkey/options": "passkey_options_user",
  "/v1/me/credentials/passkey": "default",
  "/v1/me/credentials/passkey/{id}": "default",
  "/v1/me/credentials/totp": "default",
  "/v1/me/credentials/totp/confirm": "totp_verification",
  "/v1/me/credentials/federated/{connection}": "federated_start",
  "/v1/me/credentials/federated/{id}": "default",
  "/v1/me/recovery-codes": "default",
  "/v1/me/sessions": "session_validation",
  "/v1/me/sessions/{id}": "default",
  "/v1/me/devices": "session_validation",
  "/v1/me/devices/{id}": "default",
  "/v1/me/security-events": "session_validation",
  "/v1/me/consents": "session_validation",
  "/v1/me/exports": "data_export_request",
  "/v1/me/exports/{id}/download": "default",
  "/v1/me/deletion": "default",
  "/v1/admin/auth/login/passkey/options": "passkey_options_admin",
  "/v1/admin/auth/login/passkey/verify": "admin_login",
  "/v1/admin/auth/session": "session_validation",
  "/v1/admin/auth/logout": "session_validation",
  "/v1/admin/auth/step-up": "admin_login",
  "/v1/admin/users": "session_validation",
  "/v1/admin/users/{id}": "session_validation",
  "/v1/admin/users/{id}/lock": "default",
  "/v1/admin/users/{id}/unlock": "default",
  "/v1/admin/users/{id}/sessions/revoke": "default",
  "/v1/admin/users/{id}/mfa/reset": "default",
  "/v1/admin/users/{id}/password-reset": "default",
  "/v1/admin/users/{id}/deletion": "default",
  "/v1/admin/audit-events": "session_validation",
  "/v1/admin/audit-events/verify": "default",
  "/v1/admin/break-glass": "default",
  "/v1/admin/break-glass/{id}/close": "default",
  "/v1/admin/recovery-requests/{id}/approve": "default",
  "/v1/admin/service-accounts": "default",
  "/v1/admin/service-accounts/{id}/credentials": "default",
  "/v1/admin/service-accounts/{id}/credentials/{cid}": "default",
  "/v1/admin/admins": "default",
  "/v1/admin/admins/{id}/roles": "default",
  "/v1/oauth/token": "service_token_issuance"
}
