{
  "model": "opus",
  "outputStyle": "Caveman",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "luismc-artifacts@{{MARKETPLACE}}": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\" || python \"$CLAUDE_PROJECT_DIR/scripts/delivery/session_guard.py\""
          }
        ]
      }
    ]
  }
}
