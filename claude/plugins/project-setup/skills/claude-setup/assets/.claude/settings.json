{
  "model": "opus",
  "outputStyle": "Caveman",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "luismc-agents@{{MARKETPLACE}}": true,
    "luismc-audits@{{MARKETPLACE}}": true,
    "luismc-delivery@{{MARKETPLACE}}": true,
    "luismc-docs@{{MARKETPLACE}}": true,
    "luismc-project-setup@{{MARKETPLACE}}": true,
    "luismc-transcript-folds@{{MARKETPLACE}}": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/effort_drift.py\"; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$HOME/.claude/hooks/questions_stop.py\"; else python \"$HOME/.claude/hooks/questions_stop.py\"; fi"
          }
        ]
      }
    ]
  }
}
