#!/bin/sh
# Rejects a commit message that carries a Co-Authored-By trailer or an AI
# attribution line (DL-74), when the project opted in: .delivery/config.json
# sets "no_attribution": true. Without that file or key this does nothing.
#
# git passes the message file as $1. Bypass only for a reason you can state:
#   git commit --no-verify

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
config="$repo_root/.delivery/config.json"
[ -f "$config" ] || exit 0

# "no_attribution": true, with any spacing; a dependency-free test so the hook
# needs neither jq nor Python.
tr -d ' \t\r\n' < "$config" | grep -q '"no_attribution":true' || exit 0

hits=$(grep -Ein '^[[:space:]]*co-authored-by:|generated with \[?claude|generated by \[?claude|claude-session:|noreply@anthropic\.com' "$msg_file" || true)
if [ -n "$hits" ]; then
  echo "commit-msg: attribution is not allowed here (.delivery/config.json: no_attribution = true, DL-74):" >&2
  echo "$hits" | sed 's/^/    /' >&2
  echo "Remove those lines from the message and commit again." >&2
  exit 1
fi
exit 0
