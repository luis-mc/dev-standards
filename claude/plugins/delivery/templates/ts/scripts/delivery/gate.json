{
  "schema": 1,
  "track": "ts",
  "default_branch": "main",
  "setup": ["pnpm install --frozen-lockfile"],
  "timeout_minutes": 30,
  "packages": {"kind": "pnpm-workspace"},
  "widen_on": [
    "pnpm-workspace.yaml",
    "package.json",
    "turbo.jsonc",
    "tsconfig.json",
    "vitest.config.ts",
    "eslint.config.mjs",
    ".github/",
    "scripts/delivery/"
  ],
  "lockfile_scope": "pnpm-importers",
  "inert_paths": ["docs/**"],
  "ui_paths": ["apps/web/", "apps/admin/", "packages/ui/"],
  "fail_fast_order": ["secret-scan", "change-notes", "guards", "mock-handler-guard", "lint", "typecheck", "unit", "e2e"],
  "steps": [
    {
      "name": "secret-scan",
      "scope": "always",
      "pre_push": true,
      "run": "gitleaks git --log-opts={base}..HEAD --redact --no-banner"
    },
    {
      "name": "change-notes",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/change_notes.py check --base-ref {base} || python scripts/delivery/change_notes.py check --base-ref {base}"
    },
    {
      "name": "guards",
      "scope": "always",
      "pre_push": true,
      "run": "pnpm vitest run --project guard",
      "env": {"CI": "true"}
    },
    {
      "name": "mock-handler-guard",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/mock_handler_guard.py --base-ref {base} || python scripts/delivery/mock_handler_guard.py --base-ref {base}"
    },
    {
      "name": "lint",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "pnpm turbo run lint --continue \"--filter=...[{base}]\"",
      "run_full": "pnpm turbo run lint --continue"
    },
    {
      "name": "typecheck",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "pnpm turbo run typecheck --continue \"--filter=...[{base}]\"",
      "run_full": "pnpm turbo run typecheck --continue"
    },
    {
      "name": "unit",
      "scope": "changed+dependents",
      "run": "pnpm vitest run --project unit --passWithNoTests {affected_dirs}",
      "run_full": "pnpm vitest run --project unit",
      "env": {"CI": "true"}
    },
    {
      "name": "e2e",
      "scope": "ui-changed",
      "run": "{ [ -n \"${E2E_CHROMIUM_PATH:-}\" ] && [ -x \"$E2E_CHROMIUM_PATH\" ]; } || pnpm exec playwright install chromium && pnpm exec playwright test {e2e_specs}",
      "run_full": "{ [ -n \"${E2E_CHROMIUM_PATH:-}\" ] && [ -x \"$E2E_CHROMIUM_PATH\" ]; } || pnpm exec playwright install chromium && pnpm exec playwright test",
      "env": {"CI": "true"}
    }
  ]
}
