{
  "schema": 1,
  "track": "dotnet",
  "default_branch": "main",
  "setup": ["dotnet restore --locked-mode"],
  "timeout_minutes": 30,
  "packages": {"kind": "dotnet-sln"},
  "widen_on": [
    "global.json",
    "Directory.Build.props",
    "Directory.Build.targets",
    "Directory.Packages.props",
    "nuget.config",
    ".editorconfig",
    "*.sln",
    ".github/",
    "scripts/delivery/"
  ],
  "lockfile_scope": "per-package",
  "inert_paths": ["docs/**"],
  "ui_paths": [],
  "steps": [
    {
      "name": "guards",
      "scope": "always",
      "pre_push": true,
      "run": "dotnet test --configuration Release --filter \"Category=Guard\""
    },
    {
      "name": "change-notes",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/change_notes.py check --base-ref {base} || python scripts/delivery/change_notes.py check --base-ref {base}"
    },
    {
      "name": "secret-scan",
      "scope": "always",
      "pre_push": true,
      "run": "gitleaks git --log-opts={base}..HEAD --redact --no-banner"
    },
    {
      "name": "typecheck",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "dotnet build --no-restore --configuration Release -warnaserror"
    },
    {
      "name": "unit",
      "scope": "changed",
      "run": "dotnet test --configuration Release --filter \"Category=Unit\""
    }
  ]
}
