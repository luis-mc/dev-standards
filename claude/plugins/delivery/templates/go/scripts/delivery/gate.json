{
  "schema": 1,
  "track": "go",
  "default_branch": "main",
  "setup": ["go mod download", "go mod verify", "go list -mod=readonly -m all", "go list -mod=readonly -deps -test ./..."],
  "timeout_minutes": 30,
  "packages": {"kind": "go-modules"},
  "widen_on": [
    "go.work",
    "go.work.sum",
    ".golangci.yml",
    ".github/",
    "scripts/delivery/"
  ],
  "lockfile_scope": "per-package",
  "inert_paths": ["docs/**"],
  "ui_paths": [],
  "fail_fast_order": ["secret-scan", "change-notes", "guards", "lint", "typecheck", "unit"],
  "steps": [
    {
      "name": "secret-scan",
      "scope": "always",
      "pre_push": true,
      "run": "gitleaks git --log-opts={base}..HEAD --redact --no-banner"
    },
    {
      "name": "change-notes",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/change_notes.py check --base-ref {base} || python scripts/delivery/change_notes.py check --base-ref {base}"
    },
    {
      "name": "guards",
      "scope": "always",
      "pre_push": true,
      "run": "go test -run \"^TestGuard\" ./..."
    },
    {
      "name": "lint",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "golangci-lint run --timeout=5m ./..."
    },
    {
      "name": "typecheck",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "go vet ./..."
    },
    {
      "name": "unit",
      "scope": "changed",
      "run": "go test -short ./..."
    }
  ]
}
