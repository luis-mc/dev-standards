{
  "schema": 1,
  "track": "rust",
  "default_branch": "main",
  "setup": ["cargo fetch --locked"],
  "timeout_minutes": 30,
  "packages": {"kind": "cargo-workspace"},
  "widen_on": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "deny.toml",
    ".cargo/",
    ".github/",
    "scripts/delivery/"
  ],
  "lockfile_scope": "widen",
  "inert_paths": ["docs/**"],
  "ui_paths": [],
  "steps": [
    {
      "name": "guards",
      "scope": "always",
      "pre_push": true,
      "run": "cargo test --locked --workspace guard_"
    },
    {
      "name": "change-notes",
      "scope": "always",
      "pre_push": true,
      "run": "python3 scripts/delivery/change_notes.py check --base-ref {base} || python scripts/delivery/change_notes.py check --base-ref {base}"
    },
    {
      "name": "secret-scan",
      "scope": "always",
      "pre_push": true,
      "run": "gitleaks git --log-opts={base}..HEAD --redact --no-banner"
    },
    {
      "name": "typecheck",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "cargo check --locked --workspace --all-targets"
    },
    {
      "name": "lint",
      "scope": "changed+dependents",
      "pre_push": true,
      "run": "cargo clippy --locked --workspace --all-targets -- -D warnings"
    },
    {
      "name": "unit",
      "scope": "changed",
      "run": "cargo test --locked --workspace --lib"
    }
  ]
}
