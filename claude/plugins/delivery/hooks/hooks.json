{
  "description": "luismc-delivery: Stop blocks (trains, agents, ETAs, watcher, registry, wording, questions), PreToolUse denies, SessionStart ledger summary, PostToolUse ledger writes (DELIVERYSPEC section 5). Opt-in: nothing happens in a project without .delivery/ EXCEPT the machine load guard (DL-77, DL-78): it is on in every project where the plugin is enabled, with or without .delivery/, and refuses new heavy work (tests, builds, installs, local agents) while memory is above 85% or CPU above 60% (limits configurable per machine and per project)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Agent|Workflow|RemoteTrigger|AskUserQuestion|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_pre_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_pre_tool.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|RemoteTrigger|Artifact|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Agent|RemoteTrigger|Artifact|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
