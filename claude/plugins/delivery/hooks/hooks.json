{
  "description": "luismc-delivery: Stop blocks (trains, agents, ETAs, watcher, registry, wording, questions), PreToolUse denies, SessionStart ledger summary, PostToolUse ledger writes (DELIVERYSPEC section 5). Opt-in: nothing happens in a project without .delivery/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|RemoteTrigger|AskUserQuestion|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_pre_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_pre_tool.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|RemoteTrigger|Artifact|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Agent|RemoteTrigger|Artifact|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
